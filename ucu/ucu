#!/usr/bin/env python3
"""Install, remove and check Universal Computer Use (the `ucu` MCP server) for Claude Code and opencode.

  ucu install [--python PATH]   register ucu, its Stop hook and approval policy
  ucu uninstall                 remove them
  ucu update [--auto]           bring this clone up to date and rebuild what changed
  ucu doctor                    check that everything is in place and that the server starts
  ucu deny APP                  stop agents using an app
  ucu allow APP                 let agents use an app again
  ucu denied                    list the denied apps

The server approves every app except those denied in ~/Library/Application Support/ucu/policy.json,
which install writes once (denying password managers, Keychain Access and System Settings) and then
keeps. Install builds the engine, agent-desktop from this repository, to ~/.local/bin/ucu-engine, and
ucu-window to ~/.local/bin/ucu-window.

install backs up what it changes outside this repo to
~/Library/Application Support/ucu/backups/<time>/ first.

ucu keeps itself up to date: each chat's server runs `ucu update --auto` as it starts, which looks for new commits on
the branch this clone follows at most every 10 minutes, one chat at a time, and logs to ~/Library/Logs/ucu/update.log.
It leaves a clone with local changes or commits of its own alone, and undoes an update whose engine doesn't build. The
file ~/Library/Application Support/ucu/no-auto-update turns it off.
"""
import argparse
import fcntl
import importlib.util
import json
import os
import select
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

REPO = Path(__file__).resolve().parent
PROXY = REPO / "scripts/ucu-proxy.py"
WINDOW_SOURCE = REPO / "native/ucu-window.swift"
WORKSPACE = REPO.parent

HOME = Path.home()
CLAUDE_CONFIG = HOME / ".claude.json"
SETTINGS = HOME / ".claude/settings.json"
BACKUPS = HOME / "Library/Application Support/ucu/backups"
OPENCODE_CONFIG = HOME / ".config/opencode/opencode.json"
UPDATES_OFF = HOME / "Library/Application Support/ucu/no-auto-update"
UPDATE_LOCK = HOME / "Library/Application Support/ucu/update.lock"
UPDATE_CHECKED = HOME / "Library/Application Support/ucu/update-checked"
UPDATE_LOG = HOME / "Library/Logs/ucu/update.log"
FOCUS_LOG = HOME / "Library/Logs/ucu/focus.log"  # ucu-window's account of apps that came forward during agent work
UPDATE_EVERY = 600            # seconds between the checks that chats start
UPDATE_LOG_LIMIT = 1_000_000  # bytes; the log then moves to update.log.1 and starts again
SEARCH_PATH = os.pathsep.join(
    [str(HOME / ".local/bin"), "/opt/homebrew/bin", "/usr/local/bin", os.environ.get("PATH", ""), "/usr/bin", "/bin"]
)

SERVER = "ucu"
STOP_HOOK = 'pkill -INFO -P "$PPID" -f ucu-proxy.py; exit 0'
# Claude Code settings for the server. `timeout` is a hard per-tool-call limit in ms, so a wedged call
# fails after 5 minutes instead of the 30-minute idle limit. `alwaysLoad` keeps ucu's tools in every
# prompt instead of behind tool search.
CLAUDE_EXTRAS = {"timeout": 300000, "alwaysLoad": True}
POLICY_ABOUT = ("ucu approves every app except those in deny (names match regardless of case). Change the list "
                "with `ucu deny` and `ucu allow`, or here; edits apply at the next prompt.")
# Apps the first policy denies: they hold passwords or system security settings.
DEFAULT_DENY = ["1Password", "1Password 7", "Bitwarden", "Dashlane", "Keychain Access", "Passwords",
                "System Preferences", "System Settings"]


def load_proxy():
    spec = importlib.util.spec_from_file_location("ucu_proxy", PROXY)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


proxy = load_proxy()


def say(mark, message):
    print(f"{mark} {message}")


def fail(message):
    raise SystemExit(f"✗ {message}")


def tool(name):
    return shutil.which(name, path=SEARCH_PATH)


def claude(*args):
    binary = tool("claude")
    if not binary:
        fail("the claude CLI was not found; install Claude Code first")
    return subprocess.run([binary, *args], capture_output=True, text=True, timeout=120, cwd=str(HOME))


def mcp_servers():
    try:
        return json.loads(CLAUDE_CONFIG.read_text()).get("mcpServers", {})
    except (OSError, ValueError):
        return {}


def definition(python):
    return {"type": "stdio", "command": python, "args": ["-I", str(PROXY)], "env": {}, **CLAUDE_EXTRAS}


def handshake(server, timeout=20):
    """Start a server definition as Claude Code would; return None once it answers initialize, else why not."""
    try:
        process = subprocess.Popen([server["command"], *server.get("args", [])], stdin=subprocess.PIPE,
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                   env={**os.environ, **server.get("env", {})}, cwd=str(HOME))
    except OSError as error:
        return f"could not start: {error}"
    try:
        request = {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {
            "protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "ucu", "version": "1"}}}
        process.stdin.write((json.dumps(request) + "\n").encode())
        process.stdin.flush()
        deadline = time.time() + timeout
        while time.time() < deadline:
            ready, _, _ = select.select([process.stdout], [], [], 0.5)
            if not ready:
                if process.poll() is not None:
                    return f"exited with code {process.returncode} before answering"
                continue
            line = process.stdout.readline()
            if not line:
                return "closed stdout before answering"
            try:
                reply = json.loads(line)
            except ValueError:
                continue
            if reply.get("id") == 1:
                return None if "result" in reply else (reply.get("error") or {}).get("message", json.dumps(reply)[:200])
        return f"no initialize reply within {timeout}s"
    finally:
        try:
            process.stdin.close()
            process.wait(5)
        except (OSError, subprocess.TimeoutExpired):
            process.kill()
        process.stdout.close()


def write_json(path, data):
    target = path.resolve()  # keep a symlinked config file a symlink
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(target.name + ".ucu-tmp")
    temporary.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    os.replace(temporary, target)


# --- ~/.claude/settings.json hook ---------------------------------------------
def read_settings():
    try:
        return json.loads(SETTINGS.read_text())
    except FileNotFoundError:
        return {}


def is_ucu_hook(group):
    return any("ucu-proxy.py" in hook.get("command", "") for hook in group.get("hooks", []))


def set_stop_hook(install):
    """Remove ucu's Stop hook, then add it back when `install`."""
    settings = read_settings()
    hooks = settings.setdefault("hooks", {})
    groups = [group for group in hooks.get("Stop", []) if not is_ucu_hook(group)]
    if install:
        groups.append({"hooks": [{"type": "command", "command": STOP_HOOK, "timeout": 5}]})
    if groups:
        hooks["Stop"] = groups
    else:
        hooks.pop("Stop", None)
    if not hooks:
        settings.pop("hooks")
    write_json(SETTINGS, settings)


# --- opencode -----------------------------------------------------------------
def set_opencode(python, folder=None):
    """Register ucu in opencode, if it is set up; with python=None, remove it."""
    if not OPENCODE_CONFIG.exists():
        return
    try:
        config = json.loads(OPENCODE_CONFIG.read_text())
    except (OSError, ValueError) as error:
        say("!", f"left {OPENCODE_CONFIG} as it was: {error}")
        return
    if folder:
        shutil.copy2(OPENCODE_CONFIG, folder / OPENCODE_CONFIG.name)
    servers = config.setdefault("mcp", {})
    if python:
        servers[SERVER] = {"type": "local", "command": [python, "-I", str(PROXY)], "enabled": True}
    else:
        servers.pop(SERVER, None)
    if not servers:
        config.pop("mcp")
    write_json(OPENCODE_CONFIG, config)
    say("✓", f"{'registered' if python else 'removed'} {SERVER} in {OPENCODE_CONFIG}")


# --- approval policy ----------------------------------------------------------
def read_policy():
    try:
        policy = json.loads(proxy.POLICY.read_text())
    except FileNotFoundError:
        return {"about": POLICY_ABOUT, "deny": []}
    except (OSError, ValueError) as error:
        fail(f"could not read {proxy.POLICY}: {error}")
    if not isinstance(policy, dict) or not isinstance(policy.get("deny", []), list):
        fail(f"{proxy.POLICY} needs a `deny` list of app names")
    return policy


def set_denied(app, denied):
    policy = read_policy()
    names = [name for name in policy.get("deny", []) if proxy.app_key(name) != proxy.app_key(app)]
    policy["deny"] = names + [app] if denied else names
    write_json(proxy.POLICY, policy)
    say("✓", f"{app} is {'denied' if denied else 'approved'} from the next prompt on")
    return 0


def list_denied():
    names = read_policy().get("deny", [])
    print("\n".join(names) if names else "No apps are denied: every app is approved.")
    return 0


# --- install ------------------------------------------------------------------
def backup():
    folder = BACKUPS / datetime.now().strftime("%Y%m%d-%H%M%S")
    folder.mkdir(parents=True, exist_ok=True)
    servers = {name: entry for name, entry in mcp_servers().items() if name == SERVER}
    (folder / "mcp-servers.json").write_text(json.dumps(servers, indent=2) + "\n")
    if SETTINGS.exists():
        shutil.copy2(SETTINGS, folder / "settings.json")
    return folder


def seed_policy():
    if proxy.POLICY.exists():
        say("✓", f"kept your approval policy {proxy.POLICY}")
        return
    write_json(proxy.POLICY, {"about": POLICY_ABOUT, "deny": DEFAULT_DENY})
    say("✓", f"wrote {proxy.POLICY}: every app is approved except {len(DEFAULT_DENY)} that hold passwords or "
             "system settings")


def build_engine():
    """Build agent-desktop and install it, or say why not. A rustup install has no `cargo` on PATH of its own."""
    env = dict(os.environ)
    cargo = tool("cargo")
    if not cargo and tool("rustup"):
        found = subprocess.run([tool("rustup"), "which", "cargo"], capture_output=True, text=True, cwd=str(WORKSPACE))
        if found.returncode == 0:
            cargo = found.stdout.strip()
            env["PATH"] = os.pathsep.join([str(Path(cargo).parent), env.get("PATH", "")])
    if not cargo:
        return "cargo was not found; install Rust with rustup"
    result = subprocess.run([cargo, "build", "--release", "-p", "agent-desktop"], capture_output=True, text=True,
                            cwd=str(WORKSPACE), env=env)
    if result.returncode != 0:
        return f"could not build the engine: {(result.stderr or result.stdout).strip()[-300:]}"
    proxy.ENGINE.parent.mkdir(parents=True, exist_ok=True)
    built = Path(os.environ.get("CARGO_TARGET_DIR") or WORKSPACE / "target") / "release/agent-desktop"
    if not built.exists():
        return f"the build left no {built}"
    # macOS kills a signed binary that was overwritten in place, so the new one gets a file of its own.
    temporary = proxy.ENGINE.with_name(proxy.ENGINE.name + ".ucu-tmp")
    shutil.copy2(built, temporary)
    os.replace(temporary, proxy.ENGINE)
    return None


def build_window_helper():
    swiftc = tool("swiftc")
    if not swiftc:
        say("!", "swiftc not found, so ucu-window was not built (install the Xcode command line tools)")
        return
    proxy.WINDOW_HELPER.parent.mkdir(parents=True, exist_ok=True)
    result = subprocess.run([swiftc, "-O", str(WINDOW_SOURCE), "-o", str(proxy.WINDOW_HELPER)],
                            capture_output=True, text=True)
    if result.returncode == 0:
        say("✓", f"built {proxy.WINDOW_HELPER} for the list_windows and focus_window tools")
    else:
        say("!", f"could not build ucu-window: {(result.stderr or result.stdout).strip()[-300:]}")


def install(python):
    python = str(Path(python).expanduser())  # not resolved: a stable symlink such as uv's survives upgrades
    try:
        version_ok = subprocess.run([python, "-I", "-c", "import sys; sys.exit(sys.version_info < (3, 9))"]).returncode == 0
    except OSError:
        version_ok = False
    if not version_ok:
        fail(f"{python} is not a Python 3.9 or newer")
    if not tool("claude"):
        fail("the claude CLI was not found; install Claude Code first")
    failure = handshake(definition(python))
    if failure:
        fail(f"ucu did not start ({failure}); nothing was changed")
    failure = build_engine()
    if failure:
        fail(f"{failure}; nothing was changed")
    say("✓", f"built the engine at {proxy.ENGINE}")

    folder = backup()
    say("✓", f"backed up the current setup to {folder}")
    build_window_helper()
    seed_policy()
    claude("mcp", "remove", SERVER, "-s", "user")  # absent is fine
    result = claude("mcp", "add-json", SERVER, json.dumps(definition(python)), "-s", "user")
    if result.returncode != 0 or SERVER not in mcp_servers():
        fail(f"could not register {SERVER}: {(result.stderr or result.stdout).strip()[:300]}")
    say("✓", f"registered {SERVER} in {CLAUDE_CONFIG}")
    set_stop_hook(True)
    say("✓", f"set ucu's Stop hook in {SETTINGS}")
    set_opencode(python, folder)
    print(f'Done. New sessions get `{SERVER}`; open ones need a restart. Run `./ucu deny "App Name"` to block an app.')
    return 0


# --- uninstall ----------------------------------------------------------------
def uninstall():
    set_stop_hook(False)
    if SERVER in mcp_servers():
        claude("mcp", "remove", SERVER, "-s", "user")
    set_opencode(None)
    proxy.WINDOW_HELPER.unlink(missing_ok=True)
    proxy.ENGINE.unlink(missing_ok=True)
    say("✓", f"removed {SERVER}, its hook, ucu-window and the engine (your policy stays in {proxy.POLICY})")
    return 0


# --- update -------------------------------------------------------------------
def git(*args):
    """Run git in this clone. It never asks for a password, and one that can't run or answer in time has failed."""
    try:
        return subprocess.run([tool("git") or "git", "-C", str(WORKSPACE), *args], capture_output=True, text=True,
                              timeout=120, stdin=subprocess.DEVNULL, env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
    except (OSError, subprocess.TimeoutExpired) as error:
        return subprocess.CompletedProcess(args, 1, "", str(error))


def update_blocker():
    """Return why this clone can't update itself, or None."""
    upstream = git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream.returncode != 0:
        return "this clone isn't on a branch that follows a remote one"
    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        return "this clone has local changes"
    if git("rev-list", "--count", "@{u}..HEAD").stdout.strip() not in ("", "0"):
        return f"this clone has commits that {upstream.stdout.strip()} doesn't"
    return None


def pull():
    """Fast-forward this clone to the branch it follows. Return the commit it was on, or None if it didn't move."""
    blocker = update_blocker()
    if blocker:
        fail(f"{blocker}, so it was left as it is")
    fetched = git("fetch", "--quiet")
    if fetched.returncode != 0:
        fail(f"could not fetch: {fetched.stderr.strip()[-300:]}")
    old = git("rev-parse", "HEAD").stdout.strip()
    if old == git("rev-parse", "@{u}").stdout.strip():
        say("✓", "ucu is up to date")
        return None
    merged = git("merge", "--ff-only", "--quiet", "@{u}")
    if merged.returncode != 0:  # the branch it follows was rewritten
        fail(f"could not fast-forward: {(merged.stderr or merged.stdout).strip()[-300:]}")
    say("✓", "updated to " + git("log", "-1", "--format=%h %s").stdout.strip())
    return old


def log_to(path):
    """Send what this run says to a log, since nobody is watching it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.stat().st_size > UPDATE_LOG_LIMIT:
        path.replace(path.with_name(path.name + ".1"))
    handle = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(handle, 1)
    os.dup2(handle, 2)
    os.close(handle)
    print(datetime.now().strftime("%Y-%m-%d %H:%M:%S"), "checking for an update")


def update(auto):
    """Bring this clone up to date, then let the updated copy of this file rebuild what changed. With `auto`, only
    when no other chat is updating, the last check is UPDATE_EVERY seconds old, and updates aren't turned off."""
    if auto and UPDATES_OFF.exists():
        return 0
    UPDATE_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with UPDATE_LOCK.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | (fcntl.LOCK_NB if auto else 0))
        except BlockingIOError:
            return 0  # another chat is updating
        if auto:
            try:
                if time.time() - UPDATE_CHECKED.stat().st_mtime < UPDATE_EVERY:
                    return 0
            except FileNotFoundError:
                pass
            UPDATE_CHECKED.touch()
            log_to(UPDATE_LOG)
        old = pull()
        if old is None:
            return 0
        sys.stdout.flush()
        # The new version finishes the update, so whatever it builds or sets up happens now and not one update later.
        return subprocess.run([sys.executable, "-I", str(Path(__file__).resolve()), "update", "--since", old]).returncode


def finish_update(since):
    """Rebuild what changed since the commit `since`. An engine that doesn't build undoes the update, so that the
    server and the engine stay from the same version and the next check tries again."""
    changed = git("diff", "--name-only", since, "HEAD").stdout.split()
    if any(not path.startswith("ucu/") and not path.endswith(".md") for path in changed):
        failure = build_engine()
        if failure:
            undone = git("reset", "--keep", since).returncode == 0
            fail(f"{failure}; " + ("went back to the version before the update" if undone
                                   else f"and could not go back to {since[:8]}, the version before the update"))
        say("✓", f"rebuilt the engine at {proxy.ENGINE}")
    if "ucu/native/ucu-window.swift" in changed:
        build_window_helper()
    say("✓", "new chats use the new version; open ones keep theirs until they restart")
    return 0


# --- doctor -------------------------------------------------------------------
def focus_report(hours=24):
    """What the focus log says about the last day, as a doctor line, or None when there is no log yet."""
    try:
        lines = FOCUS_LOG.read_text(errors="replace").splitlines()
    except OSError:
        return None
    since = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(time.time() - hours * 3600))
    came = [line for line in lines if line[:19] >= since and " came forward over " in line]
    if not came:
        return "✓", "no app came forward during agent work in the last day"
    back = sum(line.endswith(": put back") for line in came)

    def times(count):
        return "once" if count == 1 else f"{count} times"
    message = (f"in the last day, apps came forward {times(len(came))} during agent work, and ucu gave the user's app "
               f"back {times(back)}")
    if back < len(came):
        left = times(len(came) - back)
        return "!", f"{message}; it left them in front {left}, as the user seemed to switch: {FOCUS_LOG}"
    return "✓", message


def doctor():
    failures = 0

    def check(ok, message, hint=""):
        nonlocal failures
        failures += not ok
        say("✓" if ok else "✗", message + (f": {hint}" if hint and not ok else ""))

    entry = mcp_servers().get(SERVER)
    check(entry is not None, f"{SERVER} is registered in {CLAUDE_CONFIG}", "run `ucu install`")
    if entry:
        check(entry.get("args") == ["-I", str(PROXY)], "it runs this repo's server",
              f"args are {entry.get('args')}; run `ucu install`")
        check(os.access(entry.get("command") or "", os.X_OK), f"its Python {entry.get('command')} exists",
              "run `ucu install --python PATH`")
    if proxy.ENGINE.exists():
        result = subprocess.run([str(proxy.ENGINE), "version"], capture_output=True, text=True)
        check(result.returncode == 0, f"the engine {proxy.ENGINE} runs", (result.stderr or result.stdout).strip()[:200])
    else:
        check(False, f"{proxy.ENGINE} is built", "run `ucu install` (needs Rust)")
    blocker = update_blocker()
    if UPDATES_OFF.exists():
        say("!", f"ucu doesn't update itself: {UPDATES_OFF} turns it off")
    elif blocker:
        say("!", f"ucu doesn't update itself: {blocker}")
    else:
        say("✓", "ucu updates itself from " + git("rev-parse", "--abbrev-ref", "@{u}").stdout.strip())
    if entry:
        failure = handshake({"type": "stdio", **entry})
        check(failure is None, "the server answers an MCP initialize", failure)

    hooks = read_settings().get("hooks", {})
    check(any(is_ucu_hook(group) for group in hooks.get("Stop", [])), f"the Stop hook is in {SETTINGS}",
          "run `ucu install`")
    try:
        denied = json.loads(proxy.POLICY.read_text()).get("deny")
        if isinstance(denied, list):
            check(True, f"the approval policy denies {len(denied)} apps and approves every other app")
        else:
            check(False, f"{proxy.POLICY} has a `deny` list", "until it does, every app is asked")
    except FileNotFoundError:
        check(False, f"the approval policy {proxy.POLICY} exists", "run `ucu install`; until then every app is asked")
    except (OSError, ValueError, AttributeError) as error:
        check(False, f"{proxy.POLICY} is valid", f"{error}; until it is, every app is asked")
    if proxy.WINDOW_HELPER.exists():
        result = subprocess.run([str(proxy.WINDOW_HELPER), "list"], capture_output=True, text=True)
        check(result.returncode == 0, "ucu-window can read app windows (Accessibility permission)",
              result.stderr.strip() + " (a usage message means it is out of date: run `ucu install`)")
    else:
        check(False, f"{proxy.WINDOW_HELPER} is built", "run `ucu install` (needs swiftc)")
    focus = focus_report()
    if focus:
        say(*focus)
    if OPENCODE_CONFIG.exists():
        try:
            servers = json.loads(OPENCODE_CONFIG.read_text()).get("mcp", {})
        except (OSError, ValueError):
            servers = {}
        check((servers.get(SERVER) or {}).get("command", [])[1:] == ["-I", str(PROXY)], f"opencode runs {SERVER}",
              "run `ucu install`")
    return 1 if failures else 0


def main():
    parser = argparse.ArgumentParser(prog="ucu", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    install_parser = commands.add_parser("install", help="register ucu, its hook and policy")
    install_parser.add_argument("--python", default=sys.executable,
                                help="interpreter for the server (default: the one running ucu)")
    commands.add_parser("uninstall", help="remove ucu")
    update_parser = commands.add_parser("update", help="bring this clone up to date and rebuild what changed")
    update_parser.add_argument("--auto", action="store_true",
                               help="what each chat's server runs: at most every 10 minutes, logged, one at a time")
    update_parser.add_argument("--since", help=argparse.SUPPRESS)  # the updated copy finishing an update
    commands.add_parser("doctor", help="check the installation")
    commands.add_parser("deny", help="stop agents using an app").add_argument("app", help='for example "Mail"')
    commands.add_parser("allow", help="let agents use an app again").add_argument("app")
    commands.add_parser("denied", help="list the denied apps")
    args = parser.parse_args()
    if args.command == "install":
        return install(args.python)
    if args.command == "uninstall":
        return uninstall()
    if args.command == "update":
        return finish_update(args.since) if args.since else update(args.auto)
    if args.command in ("deny", "allow"):
        return set_denied(args.app, args.command == "deny")
    if args.command == "denied":
        return list_denied()
    return doctor()


if __name__ == "__main__":
    sys.exit(main())
