def load_proxy():
    spec = importlib.util.spec_from_file_location("ucu_proxy", PROXY)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


proxy = load_proxy()


def say(mark, message):
    print(f"{mark} {message}")


def fail(message):
    raise SystemExit(f"✗ {message}")


def tool(name):
    return shutil.which(name, path=SEARCH_PATH)


def claude(*args):
    binary = tool("claude")
    if not binary:
        fail("the claude CLI was not found; install Claude Code first")
    return subprocess.run([binary, *args], capture_output=True, text=True, timeout=120, cwd=str(HOME))


def mcp_servers():
    try:
        return json.loads(CLAUDE_CONFIG.read_text()).get("mcpServers", {})
    except (OSError, ValueError):
        return {}


def definition(python):
    return {"type": "stdio", "command": python, "args": ["-I", str(PROXY)], "env": {}, **CLAUDE_EXTRAS}


def handshake(server, timeout=20):
    """Start a server definition as Claude Code would; return None once it answers initialize, else why not."""
    try:
        process = subprocess.Popen([server["command"], *server.get("args", [])], stdin=subprocess.PIPE,
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                   env={**os.environ, **server.get("env", {})}, cwd=str(HOME))
    except OSError as error:
        return f"could not start: {error}"
    try:
        request = {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {
            "protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "ucu", "version": "1"}}}
        process.stdin.write((json.dumps(request) + "\n").encode())
        process.stdin.flush()
        deadline = time.time() + timeout
        while time.time() < deadline:
            ready, _, _ = select.select([process.stdout], [], [], 0.5)
            if not ready:
                if process.poll() is not None:
                    return f"exited with code {process.returncode} before answering"
                continue
            line = process.stdout.readline()
            if not line:
                return "closed stdout before answering"
            try:
                reply = json.loads(line)
            except ValueError:
                continue
            if reply.get("id") == 1:
                return None if "result" in reply else (reply.get("error") or {}).get("message", json.dumps(reply)[:200])
        return f"no initialize reply within {timeout}s"
    finally:
        try:
            process.stdin.close()
            process.wait(5)
        except (OSError, subprocess.TimeoutExpired):
            process.kill()
        process.stdout.close()


def write_json(path, data):
    target = path.resolve()  # keep a symlinked config file a symlink
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(target.name + ".ucu-tmp")
    temporary.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    os.replace(temporary, target)


# --- ~/.claude/settings.json hook ---------------------------------------------
def read_settings():
    try:
        return json.loads(SETTINGS.read_text())
    except FileNotFoundError:
        return {}


def is_ucu_hook(group):
    return any("ucu-proxy.py" in hook.get("command", "") for hook in group.get("hooks", []))


def set_stop_hook(install):
    """Remove ucu's Stop hook, then add it back when `install`."""
    settings = read_settings()
    hooks = settings.setdefault("hooks", {})
    groups = [group for group in hooks.get("Stop", []) if not is_ucu_hook(group)]
    if install:
        groups.append({"hooks": [{"type": "command", "command": STOP_HOOK, "timeout": 5}]})
    if groups:
        hooks["Stop"] = groups
    else:
        hooks.pop("Stop", None)
    if not hooks:
        settings.pop("hooks")
    write_json(SETTINGS, settings)


# --- opencode -----------------------------------------------------------------
def set_opencode(python, folder=None):
    """Register ucu in opencode, making its config if it has none; with python=None, remove it if it is there."""
    if not OPENCODE_CONFIG.exists():
        if not python:
            return
        if OPENCODE_CONFIG.with_suffix(".jsonc").exists():  # JSON with comments, which this can't edit safely
            say("!", f"opencode keeps its config in {OPENCODE_CONFIG.with_suffix('.jsonc')}, so ucu was not added "
                     f"to it; add this under \"mcp\": {json.dumps({SERVER: opencode_entry(python)})}")
            return
        OPENCODE_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        OPENCODE_CONFIG.write_text(json.dumps({"$schema": "https://opencode.ai/config.json"}) + "\n")
    try:
        config = json.loads(OPENCODE_CONFIG.read_text())
    except (OSError, ValueError) as error:
        say("!", f"left {OPENCODE_CONFIG} as it was: {error}")
        return
    if folder:
        shutil.copy2(OPENCODE_CONFIG, folder / OPENCODE_CONFIG.name)
    servers = config.setdefault("mcp", {})
    if python:
        servers[SERVER] = opencode_entry(python)
    else:
        servers.pop(SERVER, None)
    if not servers:
        config.pop("mcp")
    write_json(OPENCODE_CONFIG, config)
    say("✓", f"{'registered' if python else 'removed'} {SERVER} in {OPENCODE_CONFIG}")


def opencode_entry(python):
    return {"type": "local", "command": [python, "-I", str(PROXY)], "enabled": True}


# --- Codex --------------------------------------------------------------------
def codex(*args):
    # codex is a Node script: node is wherever codex was found, which may not be on this process's PATH.
    return subprocess.run([tool("codex"), "mcp", *args], capture_output=True, text=True, timeout=60, cwd=str(HOME),
                          env={**os.environ, "PATH": SEARCH_PATH})


def codex_entry():
    """ucu's server as Codex has it (`codex mcp get --json`), or None."""
    if not tool("codex"):
        return None
    try:
        result = codex("get", SERVER, "--json")
        entry = json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    return entry if isinstance(entry, dict) else None


def codex_command(entry):
    """The command line a Codex entry runs, or []."""
    transport = (entry or {}).get("transport") or {}
    return [transport.get("command") or "", *(transport.get("args") or [])] if transport.get("command") else []


def set_codex(python, folder=None):
    """Register ucu in Codex through its CLI, which owns config.toml; with python=None, remove it if it is there."""
    if not tool("codex"):
        return
    if folder and CODEX_CONFIG.exists():
        shutil.copy2(CODEX_CONFIG, folder / "codex-config.toml")
    if not python:
        if codex_entry():
            codex("remove", SERVER)
            say("✓", f"removed {SERVER} from Codex")
        return
    CODEX_HOME.mkdir(parents=True, exist_ok=True)  # codex refuses to run when CODEX_HOME names no folder
    result = codex("add", SERVER, "--", python, "-I", str(PROXY))
    if result.returncode == 0:
        set_codex_timeout()
    if codex_command(codex_entry())[1:] != ["-I", str(PROXY)]:
        fail(f"could not register {SERVER} in Codex: {(result.stderr or result.stdout).strip()[:300]}")
    say("✓", f"registered {SERVER} in Codex ({CODEX_CONFIG})")


def set_codex_timeout():
    """Give ucu's tool calls in Codex the same 5 minutes as in Claude Code. `codex mcp add` has no option for it, and
    writes ucu's table afresh each time, so the line goes in just under the table's header."""
    header = f"[mcp_servers.{SERVER}]"
    try:
        target = CODEX_CONFIG.resolve()
        lines = target.read_text().splitlines(keepends=True)
    except OSError:
        return
    if not any(line.strip() == header for line in lines):
        return
    index = next(number for number, line in enumerate(lines) if line.strip() == header)
    table = lines[index + 1:]
    end = next((number for number, line in enumerate(table) if line.lstrip().startswith("[")), len(table))
    if any(line.split("=")[0].strip() == "tool_timeout_sec" for line in table[:end]):
        return
    lines.insert(index + 1, CODEX_TOOL_TIMEOUT + "\n")
    temporary = target.with_name(target.name + ".ucu-tmp")
    temporary.write_text("".join(lines))
    os.replace(temporary, target)


# --- which agents -------------------------------------------------------------
def read_state():
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}
    return state if isinstance(state, dict) else {}


def write_state(state):
    write_json(STATE, {key: value for key, value in state.items() if value})


def found_clients():
    """The agents on this Mac that ucu can be set up for."""
    found = {"claude": tool("claude"), "codex": tool("codex"), "opencode": OPENCODE_CONFIG.exists() or tool("opencode")}
    return [client for client in CLIENTS if found[client]]


def parse_clients(text):
    names = [name.strip().lower() for name in text.split(",") if name.strip()]
    names = ["claude" if name in ("claude-code", "claudecode") else name for name in names]
    unknown = [name for name in names if name not in CLIENTS and name != "all"]
    if unknown or not names:
        fail(f"--clients takes `all` or a list of {', '.join(CLIENTS)}, such as claude,codex; not {text!r}")
    return list(CLIENTS) if "all" in names else [client for client in CLIENTS if client in names]


def choose_clients(requested):
    """The agents to set ucu up for: those --clients names, else those chosen last time, else every one found."""
    found = found_clients()
    chosen = parse_clients(requested) if requested else []
    if chosen and "all" not in requested.lower():
        missing = [CLIENTS[client] for client in chosen if client not in found]
        if missing:
            fail(f"{' and '.join(missing)} {'was' if len(missing) == 1 else 'were'} not found on this Mac; install "
                 "it first or leave it out of --clients. Nothing was changed")
        return chosen
    saved = [] if requested else [client for client in read_state().get("clients", []) if client in CLIENTS]
    for client in saved:
        if client not in found:
            say("!", f"{CLIENTS[client]} was chosen before but is no longer found, so it is left out")
    chosen = [client for client in saved if client in found] or found
    if not chosen:
        fail("no agent was found: install Claude Code (the claude command), Codex (the codex command) or opencode "
             f"({OPENCODE_CONFIG}) first")
    return chosen


# --- the rule that tells agents to use ucu --------------------------------------
def rule_files(clients, folder=None):
    """The instruction files the rule goes in for these agents, globally or in a project folder, each file once even
    when one is a link to another, as Codex's and opencode's AGENTS.md often are to Claude's CLAUDE.md."""
    files = {}
    for client in clients:
        path = GLOBAL_RULES[client] if folder is None else Path(folder) / PROJECT_RULES[client]
        files.setdefault(path.resolve(), None)
    return list(files)


def without_rule(text):
    start = text.find(RULE_START)
    end = text.find(RULE_END, start)
    if start < 0 or end < 0:
        return text
    before, after = text[:start].rstrip("\n"), text[end + len(RULE_END):].lstrip("\n")
    rest = "\n\n".join(part for part in (before, after) if part.strip())
    if not rest.strip():
        return ""
    return rest if rest.endswith("\n") else rest + "\n"


def set_rule(path, present):
    """Add ucu's rule to the end of an instruction file, or take it out. Return whether the file changed."""
    block = f"{RULE_START}\n{RULE}\n{RULE_END}\n"
    try:
        text = path.read_text()
    except FileNotFoundError:
        if not present:
            return False
        text = ""
    if present and block in text:
        return False
    rest = without_rule(text)
    new = (rest.rstrip("\n") + "\n\n" + block if rest.strip() else block) if present else rest
    if new == text:
        return False
    if not new:  # the file held nothing but the rule
        path.unlink()
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".ucu-tmp")
    temporary.write_text(new)
    os.replace(temporary, path)
    return True


def set_global_rule(clients, present):
    """Put the rule in the global instructions of these agents, and take it out of every other agent's."""
    wanted = rule_files(clients) if present else []
    for path in rule_files(CLIENTS):
        if path not in wanted and set_rule(path, False):
            say("✓", f"took the rule to use ucu out of {path}")
    for path in wanted:
        if set_rule(path, True):
            say("✓", f"added the rule to use ucu to {path}")
        else:
            say("✓", f"the rule to use ucu is already in {path}")


def rule(action, everywhere, folders):
    """`ucu rule add|remove [--global] [FOLDER ...]`."""
    if not everywhere and not folders:
        fail("name --global, a project folder, or both")
    state = read_state()
    clients = [client for client in state.get("clients", []) if client in CLIENTS] or found_clients() or list(CLIENTS)
    folders = [Path(folder).expanduser().resolve() for folder in folders]
    for folder in folders:
        if not folder.is_dir():
            fail(f"{folder} is not a folder. Nothing was changed")
    paths = [path for folder in folders for path in rule_files(clients if action == "add" else CLIENTS, folder)]
    backup([*paths, *(rule_files(CLIENTS) if everywhere else [])])
    if everywhere:
        set_global_rule(clients, action == "add")
        state["rule"] = "global" if action == "add" else None
    projects = [project for project in state.get("project_rules", []) if Path(project) not in paths]
    for path in paths:
        changed = set_rule(path, action == "add")
        if action == "add":
            projects.append(str(path))
        say("✓", f"{'added the rule to use ucu to' if action == 'add' else 'took the rule to use ucu out of'} {path}"
            if changed else f"{path} {'already has' if action == 'add' else 'has no'} rule to use ucu")
    state["project_rules"] = sorted(set(projects))
    write_state(state)
    print("Agents read the rule when a session starts, so open sessions need a restart.")
    return 0


# --- Chrome extension ---------------------------------------------------------
def set_chrome_host(python):
    """Let ucu's Chrome extension start its host, if Chrome is set up; with python=None, take that away."""
    if not python:
        CHROME_HOST_MANIFEST.unlink(missing_ok=True)
        CHROME_HOST_LAUNCHER.unlink(missing_ok=True)
        return
    if not CHROME.exists():
        return
    CHROME_HOST_LAUNCHER.parent.mkdir(parents=True, exist_ok=True)  # Chrome runs a program, not a command line
    CHROME_HOST_LAUNCHER.write_text(f'#!/bin/sh\nexec "{python}" -I "{REPO / "scripts/ucu-chrome-host.py"}"\n')
    CHROME_HOST_LAUNCHER.chmod(0o755)
    write_json(CHROME_HOST_MANIFEST, {
        "name": CHROME_HOST, "description": "Universal Computer Use", "path": str(CHROME_HOST_LAUNCHER),
        "type": "stdio", "allowed_origins": [f"chrome-extension://{CHROME_EXTENSION}/"]})
    say("✓", f"registered the host of ucu's Chrome extension; to use it, load {REPO / 'chrome-extension'} once at "
             "chrome://extensions (Developer mode, Load unpacked)")


# --- approval policy ----------------------------------------------------------
def read_policy():
    try:
        policy = json.loads(proxy.POLICY.read_text())
    except FileNotFoundError:
        return {"about": POLICY_ABOUT, "deny": []}
    except (OSError, ValueError) as error:
        fail(f"could not read {proxy.POLICY}: {error}")
    if not isinstance(policy, dict) or not isinstance(policy.get("deny", []), list):
        fail(f"{proxy.POLICY} needs a `deny` list of app names")
    return policy


def set_denied(app, denied):
    policy = read_policy()
    names = [name for name in policy.get("deny", []) if proxy.app_key(name) != proxy.app_key(app)]
    policy["deny"] = names + [app] if denied else names
    write_json(proxy.POLICY, policy)
    say("✓", f"{app} is {'denied' if denied else 'approved'} from the next prompt on")
    return 0


def list_denied():
    names = read_policy().get("deny", [])
    print("\n".join(names) if names else "No apps are denied: every app is approved.")
    return 0


# --- install ------------------------------------------------------------------
def backup(files=()):
    """Copy what install and `ucu rule` change to a new backup folder; `files` keep their full path under files/."""
    folder = BACKUPS / datetime.now().strftime("%Y%m%d-%H%M%S")
    folder.mkdir(parents=True, exist_ok=True)
    servers = {name: entry for name, entry in mcp_servers().items() if name == SERVER}
    (folder / "mcp-servers.json").write_text(json.dumps(servers, indent=2) + "\n")
    if SETTINGS.exists():
        shutil.copy2(SETTINGS, folder / "settings.json")
    for path in files:
        if path.is_file():
            copy = folder / "files" / path.relative_to(path.anchor)
            copy.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, copy)
    return folder


def seed_policy():
    if proxy.POLICY.exists():
        say("✓", f"kept your approval policy {proxy.POLICY}")
        return
    write_json(proxy.POLICY, {"about": POLICY_ABOUT, "deny": DEFAULT_DENY})
    say("✓", f"wrote {proxy.POLICY}: every app is approved except {len(DEFAULT_DENY)} that hold passwords or "
             "system settings")


def build_engine():
    """Build agent-desktop and install it, or say why not. cargo may not be on PATH: a Homebrew rustup has no `cargo`
    of its own, and a new rustup install's ~/.cargo/bin is only on PATH in shells started after it."""
    cargo = tool("cargo")
    if not cargo and tool("rustup"):
        found = subprocess.run([tool("rustup"), "which", "cargo"], capture_output=True, text=True, cwd=str(WORKSPACE))
        if found.returncode == 0:
            cargo = found.stdout.strip()
    if not cargo:
        return "cargo was not found; install Rust with rustup"
    env = {**os.environ, "PATH": os.pathsep.join([str(Path(cargo).parent), os.environ.get("PATH", "")])}
    result = subprocess.run([cargo, "build", "--release", "-p", "agent-desktop"], capture_output=True, text=True,
                            cwd=str(WORKSPACE), env=env)
    if result.returncode != 0:
        return f"could not build the engine: {(result.stderr or result.stdout).strip()[-300:]}"
    proxy.ENGINE.parent.mkdir(parents=True, exist_ok=True)
    built = Path(os.environ.get("CARGO_TARGET_DIR") or WORKSPACE / "target") / "release/agent-desktop"
    if not built.exists():
        return f"the build left no {built}"
    # macOS kills a signed binary that was overwritten in place, so the new one gets a file of its own.
    temporary = proxy.ENGINE.with_name(proxy.ENGINE.name + ".ucu-tmp")
    shutil.copy2(built, temporary)
    os.replace(temporary, proxy.ENGINE)
    return None


def build_window_helper():
    swiftc = tool("swiftc")
    if not swiftc:
        say("!", "swiftc not found, so ucu-window was not built (install the Xcode command line tools)")
        return
    proxy.WINDOW_HELPER.parent.mkdir(parents=True, exist_ok=True)
    result = subprocess.run([swiftc, "-O", str(WINDOW_SOURCE), "-o", str(proxy.WINDOW_HELPER)],
                            capture_output=True, text=True)
    if result.returncode == 0:
        say("✓", f"built {proxy.WINDOW_HELPER} for the list_windows and focus_window tools")
    else:
        say("!", f"could not build ucu-window: {(result.stderr or result.stdout).strip()[-300:]}")


def install(python, requested_clients=None, requested_rule=None):
    python = str(Path(python).expanduser())  # not resolved: a stable symlink such as uv's survives upgrades
    try:
        version_ok = subprocess.run([python, "-I", "-c", "import sys; sys.exit(sys.version_info < (3, 9))"]).returncode == 0
    except OSError:
        version_ok = False
    if not version_ok:
        fail(f"{python} is not a Python 3.9 or newer")
    clients = choose_clients(requested_clients)
    state = read_state()
    rule_global = (requested_rule or state.get("rule") or "none") == "global"
    failure = handshake(definition(python))
    if failure:
        fail(f"ucu did not start ({failure}); nothing was changed")
    say("→", "building the engine with cargo, which takes a few minutes the first time")
    failure = build_engine()
    if failure:
        fail(f"{failure}; nothing was changed")
    say("✓", f"built the engine at {proxy.ENGINE}")

    folder = backup(rule_files(CLIENTS))
    say("✓", f"backed up the current setup to {folder}")
    build_window_helper()
    seed_policy()
    if "claude" in clients:
        claude("mcp", "remove", SERVER, "-s", "user")  # absent is fine
        result = claude("mcp", "add-json", SERVER, json.dumps(definition(python)), "-s", "user")
        if result.returncode != 0 or SERVER not in mcp_servers():
            fail(f"could not register {SERVER}: {(result.stderr or result.stdout).strip()[:300]}")
        say("✓", f"registered {SERVER} in {CLAUDE_CONFIG}")
        set_stop_hook(True)
        say("✓", f"set ucu's Stop hook in {SETTINGS}")
    else:
        remove_from_claude()
    set_codex(python if "codex" in clients else None, folder)
    set_opencode(python if "opencode" in clients else None, folder)
    set_global_rule(clients, rule_global)
    write_state({**state, "clients": clients, "rule": "global" if rule_global else None})
    set_chrome_host(python)
    names = " and ".join(CLIENTS[client] for client in clients)
    print(f"Done. ucu is set up for {names}. New sessions get `{SERVER}`; open ones need a restart. "
          f'Run `"{REPO / "ucu"}" deny "App Name"` to block an app.')
    return 0


def remove_from_claude():
    """Take ucu's server and Stop hook out of Claude Code, if they are there."""
    if any(is_ucu_hook(group) for group in read_settings().get("hooks", {}).get("Stop", [])):
        set_stop_hook(False)
    if SERVER in mcp_servers() and tool("claude"):
        claude("mcp", "remove", SERVER, "-s", "user")
        say("✓", f"removed {SERVER} from Claude Code")


# --- uninstall ----------------------------------------------------------------
def uninstall():
    remove_from_claude()
    set_codex(None)
    set_opencode(None)
    set_global_rule([], False)
    for path in read_state().get("project_rules", []):
        if set_rule(Path(path), False):
            say("✓", f"took the rule to use ucu out of {path}")
    STATE.unlink(missing_ok=True)
    set_chrome_host(None)
    proxy.WINDOW_HELPER.unlink(missing_ok=True)
    proxy.ENGINE.unlink(missing_ok=True)
    say("✓", f"removed {SERVER}, its hook, ucu-window and the engine (your policy stays in {proxy.POLICY})")
    return 0


# --- update -------------------------------------------------------------------
def git(*args):
    """Run git in this clone. It never asks for a password, and one that can't run or answer in time has failed."""
    try:
        return subprocess.run([tool("git") or "git", "-C", str(WORKSPACE), *args], capture_output=True, text=True,
                              timeout=120, stdin=subprocess.DEVNULL, env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
    except (OSError, subprocess.TimeoutExpired) as error:
        return subprocess.CompletedProcess(args, 1, "", str(error))


def update_blocker():
    """Return why this clone can't update itself, or None."""
    upstream = git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream.returncode != 0:
        return "this clone isn't on a branch that follows a remote one"
    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        return "this clone has local changes"
    if git("rev-list", "--count", "@{u}..HEAD").stdout.strip() not in ("", "0"):
        return f"this clone has commits that {upstream.stdout.strip()} doesn't"
    return None


def pull():
    """Fast-forward this clone to the branch it follows. Return the commit it was on, or None if it didn't move."""
    blocker = update_blocker()
    if blocker:
        fail(f"{blocker}, so it was left as it is")
    fetched = git("fetch", "--quiet")
    if fetched.returncode != 0:
        fail(f"could not fetch: {fetched.stderr.strip()[-300:]}")
    old = git("rev-parse", "HEAD").stdout.strip()
    if old == git("rev-parse", "@{u}").stdout.strip():
        say("✓", "ucu is up to date")
        return None
    merged = git("merge", "--ff-only", "--quiet", "@{u}")
    if merged.returncode != 0:  # the branch it follows was rewritten
        fail(f"could not fast-forward: {(merged.stderr or merged.stdout).strip()[-300:]}")
    say("✓", "updated to " + git("log", "-1", "--format=%h %s").stdout.strip())
    return old


def log_to(path):
    """Send what this run says to a log, since nobody is watching it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.stat().st_size > UPDATE_LOG_LIMIT:
        path.replace(path.with_name(path.name + ".1"))
    handle = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(handle, 1)
    os.dup2(handle, 2)
    os.close(handle)
    print(datetime.now().strftime("%Y-%m-%d %H:%M:%S"), "checking for an update")


def update(auto):
    """Bring this clone up to date, then let the updated copy of this file rebuild what changed. With `auto`, only
    when no other chat is updating, the last check is UPDATE_EVERY seconds old, and updates aren't turned off."""
    if auto and UPDATES_OFF.exists():
        return 0
    UPDATE_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with UPDATE_LOCK.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | (fcntl.LOCK_NB if auto else 0))
        except BlockingIOError:
            return 0  # another chat is updating
        if auto:
            try:
                if time.time() - UPDATE_CHECKED.stat().st_mtime < UPDATE_EVERY:
                    return 0
            except FileNotFoundError:
                pass
            UPDATE_CHECKED.touch()
            log_to(UPDATE_LOG)
        old = pull()
        if old is None:
            return 0
        sys.stdout.flush()
        # The new version finishes the update, so whatever it builds or sets up happens now and not one update later.
        return subprocess.run([sys.executable, "-I", str(Path(__file__).resolve()), "update", "--since", old]).returncode


def finish_update(since):
    """Rebuild what changed since the commit `since`. An engine that doesn't build undoes the update, so that the
    server and the engine stay from the same version and the next check tries again."""
    changed = git("diff", "--name-only", since, "HEAD").stdout.split()
    if any(not path.startswith("ucu/") and not path.endswith(".md") for path in changed):
        failure = build_engine()
        if failure:
            undone = git("reset", "--keep", since).returncode == 0
            fail(f"{failure}; " + ("went back to the version before the update" if undone
                                   else f"and could not go back to {since[:8]}, the version before the update"))
        say("✓", f"rebuilt the engine at {proxy.ENGINE}")
    if "ucu/native/ucu-window.swift" in changed:
        build_window_helper()
    say("✓", "new chats use the new version; open ones keep theirs until they restart")
    return 0


# --- doctor -------------------------------------------------------------------
def focus_report(hours=24):
    """What the focus log says about the last day, as a doctor line, or None when there is no log yet."""
    try:
        lines = FOCUS_LOG.read_text(errors="replace").splitlines()
    except OSError:
        return None
    since = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(time.time() - hours * 3600))
    came = [line for line in lines if line[:19] >= since and " came forward over " in line]
    if not came:
        return "✓", "no app came forward during agent work in the last day"
    back = sum(line.endswith(": put back") for line in came)

    def times(count):
        return "once" if count == 1 else f"{count} times"
    message = (f"in the last day, apps came forward {times(len(came))} during agent work, and ucu gave the user's app "
               f"back {times(back)}")
    if back < len(came):
        left = times(len(came) - back)
        return "!", f"{message}; it left them in front {left}, as the user seemed to switch: {FOCUS_LOG}"
    return "✓", message


def doctor():
    failures = 0

    def check(ok, message, hint=""):
        nonlocal failures
        failures += not ok
        say("✓" if ok else "✗", message + (f": {hint}" if hint and not ok else ""))

    state = read_state()
    clients = [client for client in state.get("clients", []) if client in CLIENTS] or installed_clients()
    say("✓", "ucu is set up for " + " and ".join(CLIENTS[client] for client in clients))
    commands = []
    if "claude" in clients:
        entry = mcp_servers().get(SERVER)
        check(entry is not None, f"{SERVER} is registered in {CLAUDE_CONFIG}", "run `ucu install`")
        if entry:
            check(entry.get("args") == ["-I", str(PROXY)], "it runs this repo's server",
                  f"args are {entry.get('args')}; run `ucu install`")
            check(os.access(entry.get("command") or "", os.X_OK), f"its Python {entry.get('command')} exists",
                  "run `ucu install --python PATH`")
            commands.append([entry.get("command") or "", *(entry.get("args") or [])])
    if "codex" in clients:
        entry = codex_entry()
        check(codex_command(entry)[1:] == ["-I", str(PROXY)], f"Codex runs {SERVER}", "run `ucu install`")
        if entry:
            check(entry.get("tool_timeout_sec") == 300, "Codex gives ucu's tool calls 5 minutes", "run `ucu install`")
            commands.append(codex_command(entry))
    if "opencode" in clients:
        try:
            servers = json.loads(OPENCODE_CONFIG.read_text()).get("mcp", {})
        except (OSError, ValueError, AttributeError):
            servers = {}
        command = (servers.get(SERVER) or {}).get("command", []) if isinstance(servers, dict) else []
        check(command[1:] == ["-I", str(PROXY)], f"opencode runs {SERVER}", "run `ucu install`")
        commands.append(command)
    if proxy.ENGINE.exists():
        result = subprocess.run([str(proxy.ENGINE), "version"], capture_output=True, text=True)
        check(result.returncode == 0, f"the engine {proxy.ENGINE} runs", (result.stderr or result.stdout).strip()[:200])
    else:
        check(False, f"{proxy.ENGINE} is built", "run `ucu install` (needs Rust)")
    blocker = update_blocker()
    if UPDATES_OFF.exists():
        say("!", f"ucu doesn't update itself: {UPDATES_OFF} turns it off")
    elif blocker:
        say("!", f"ucu doesn't update itself: {blocker}")
    else:
        say("✓", "ucu updates itself from " + git("rev-parse", "--abbrev-ref", "@{u}").stdout.strip())
    command = next((command for command in commands if command[1:] == ["-I", str(PROXY)]), None)
    if command:
        failure = handshake({"command": command[0], "args": command[1:]})
        check(failure is None, "the server answers an MCP initialize", failure)

    if "claude" in clients:
        hooks = read_settings().get("hooks", {})
        check(any(is_ucu_hook(group) for group in hooks.get("Stop", [])), f"the Stop hook is in {SETTINGS}",
              "run `ucu install`")
    try:
        denied = json.loads(proxy.POLICY.read_text()).get("deny")
        if isinstance(denied, list):
            check(True, f"the approval policy denies {len(denied)} apps and approves every other app")
        else:
            check(False, f"{proxy.POLICY} has a `deny` list", "until it does, every app is asked")
    except FileNotFoundError:
        check(False, f"the approval policy {proxy.POLICY} exists", "run `ucu install`; until then every app is asked")
    except (OSError, ValueError, AttributeError) as error:
        check(False, f"{proxy.POLICY} is valid", f"{error}; until it is, every app is asked")
    if proxy.WINDOW_HELPER.exists():
        result = subprocess.run([str(proxy.WINDOW_HELPER), "list"], capture_output=True, text=True)
        check(result.returncode == 0, "ucu-window can read app windows (Accessibility permission)",
              result.stderr.strip() + " (a usage message means it is out of date: run `ucu install`)")
    else:
        check(False, f"{proxy.WINDOW_HELPER} is built", "run `ucu install` (needs swiftc)")
    focus = focus_report()
    if focus:
        say(*focus)
    if state.get("rule") == "global":
        for path in rule_files(clients):
            try:
                present = RULE_START in path.read_text()
            except OSError:
                present = False
            check(present, f"the rule to use ucu is in {path}", "run `ucu rule add --global`")
    for path in map(Path, state.get("project_rules", [])):
        present = path.is_file() and RULE_START in path.read_text()
        say("✓" if present else "!", f"the rule to use ucu is in {path}" if present
            else f"{path} no longer has the rule to use ucu; `ucu rule add {path.parent}` puts it back")
    return 1 if failures else 0


def installed_clients():
    """The agents an install from before ucu remembered its choice set up: Claude Code unless it is opencode alone."""
    entry = mcp_servers().get(SERVER)
    clients = [] if entry is None and not tool("claude") and OPENCODE_CONFIG.exists() else ["claude"]
    if codex_entry():
        clients.append("codex")
    if OPENCODE_CONFIG.exists():
        clients.append("opencode")
    return clients


def main():
    parser = argparse.ArgumentParser(prog="ucu", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    install_parser = commands.add_parser("install", help="register ucu, its hook and policy")
    install_parser.add_argument("--python", default=sys.executable,
                                help="interpreter for the server (default: the one running ucu)")
    install_parser.add_argument("--clients", help="the agents to set ucu up for: `all` (every one found) or a list "
                                "such as claude,codex,opencode (default: the ones chosen last time, else all)")
    install_parser.add_argument("--rule", choices=("global", "none"),
                                help="global: tell those agents in their global instructions to use ucu instead of "
                                "built-in computer use; none: take that out (default: as chosen last time, else none)")
    rule_parser = commands.add_parser("rule", help="tell agents to use ucu instead of built-in computer use, or stop")
    rule_parser.add_argument("action", choices=("add", "remove"))
    rule_parser.add_argument("--global", dest="everywhere", action="store_true",
                             help="in the agents' global instructions, such as ~/.claude/CLAUDE.md")
    rule_parser.add_argument("folders", nargs="*", metavar="FOLDER",
                             help="a project: its CLAUDE.md for Claude Code, its AGENTS.md for Codex and opencode")
    commands.add_parser("uninstall", help="remove ucu")
    update_parser = commands.add_parser("update", help="bring this clone up to date and rebuild what changed")
    update_parser.add_argument("--auto", action="store_true",
                               help="what each chat's server runs: at most every 10 minutes, logged, one at a time")
    update_parser.add_argument("--since", help=argparse.SUPPRESS)  # the updated copy finishing an update
    commands.add_parser("doctor", help="check the installation")
    commands.add_parser("deny", help="stop agents using an app").add_argument("app", help='for example "Mail"')
    commands.add_parser("allow", help="let agents use an app again").add_argument("app")
    commands.add_parser("denied", help="list the denied apps")
    # Before Python 3.12, argparse leaves folders that follow `--global` over, as in `rule add --global ~/app`.
    args, extra = parser.parse_known_args()
    if extra and args.command == "rule" and not any(word.startswith("-") for word in extra):
        args.folders += extra
    elif extra:
        parser.error(f"unrecognized arguments: {' '.join(extra)}")
    if args.command == "install":
        return install(args.python, args.clients, args.rule)
    if args.command == "rule":
        return rule(args.action, args.everywhere, args.folders)
    if args.command == "uninstall":
        return uninstall()
    if args.command == "update":
        return finish_update(args.since) if args.since else update(args.auto)
    if args.command in ("deny", "allow"):
        return set_denied(args.app, args.command == "deny")
    if args.command == "denied":
        return list_denied()
    return doctor()


if __name__ == "__main__":
    sys.exit(main())
